# ---- FactorIA Agent Core · variables de entorno ----
# Copia a .env (local) o a Vercel → Settings → Environment Variables.
# Los secretos NUNCA se versionan.

# Postgres (Supabase) — transaction pooler (puerto 6543) para apps serverless.
# Ej: postgresql://postgres.<ref>:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ElevenLabs API Key (server-side, NUNCA expuesta al cliente).
# Se usa para: provisioning (agentes, tools, secret store) y signed URL de sesión.
ELEVENLABS_API_KEY=

# Secret del webhook post-call de ElevenLabs (verificación HMAC del endpoint entrante).
# Lo usa app/api/webhooks/elevenlabs/route.ts. Vacío = endpoint deshabilitado.
ELEVENLABS_WEBHOOK_SECRET=

# Secret Bearer de cada tenant. Los NOMBRES salen de config/tenants/<id>.json
# (auth.secretRef) y los VALORES los genera `npm run setup -- --tenant <id>`.
# El dispatcher resuelve el tenant comparando SHA-256 del Bearer contra la DB,
# así que en producción el valor debe coincidir con el secret store de ElevenLabs.
# Ejemplos:
#   FACTORIA_TENANT_MESA_SECRET=
#   FACTORIA_TENANT_VITEA_SECRET=

# URL base de la deployment. La usa el provisioning para apuntar las webhook tools
# a https://<base>/api/tools/<tool> — en producción DEBE ser la URL pública,
# porque ElevenLabs no puede resolver localhost.
#   local      → http://localhost:3000
#   producción → https://factoria-agent-platform-poc.vercel.app
NEXT_PUBLIC_FACTORIA_BASE_URL=http://localhost:3000
